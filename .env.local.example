# Supabase Configuration
# Copy this file to .env.local and fill in your values from https://app.supabase.com/project/<ref>/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# SERVICE ROLE KEY - NEVER expose this client-side. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Low-stock alert thresholds (kg)
NEXT_PUBLIC_LOW_STOCK_GREEN_KG=60
NEXT_PUBLIC_LOW_STOCK_ROASTED_KG=5
